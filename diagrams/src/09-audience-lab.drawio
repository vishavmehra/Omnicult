<mxfile host="app.diagrams.net" agent="Omnicult diagrams" version="24.7.0"><diagram id="09-audience-lab" name="09-audience-lab"><mxGraphModel dx="1400" dy="660" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="660" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_title" value="09 · Audience Lab" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=22;fontColor=#202124;fontStyle=1;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1340" height="30" as="geometry"/></mxCell><mxCell id="t_sub" value="A synthetic panel built in code, seven tools on top, and analytics that never claim real-world evidence" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontColor=#5F6368;fontStyle=0;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="48" width="1340" height="22" as="geometry"/></mxCell><mxCell id="LT" value="Audience Lab tools (all synthetic)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#5F6368;fillColor=#F3E8FD;strokeColor=#9334E6;dashed=0;opacity=60;textOpacity=100;" vertex="1" parent="1"><mxGeometry x="570" y="90" width="560" height="410" as="geometry"/></mxCell><mxCell id="i1" value="&lt;b&gt;Creative version&lt;/b&gt;&lt;br&gt;image, text or video from Studio" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3C4043;fontColor=#202124;fontSize=12;fontFamily=Helvetica;strokeWidth=1.5;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="30" y="150" width="220" height="64" as="geometry"/></mxCell><mxCell id="i2" value="&lt;b&gt;Market Lens claims&lt;/b&gt;&lt;br&gt;cited evidence for the state" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3C4043;fontColor=#202124;fontSize=12;fontFamily=Helvetica;strokeWidth=1.5;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="30" y="240" width="220" height="64" as="geometry"/></mxCell><mxCell id="i3" value="&lt;b&gt;Brief and Brand Kit&lt;/b&gt;&lt;br&gt;objective, regions, tone" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3C4043;fontColor=#202124;fontSize=12;fontFamily=Helvetica;strokeWidth=1.5;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="220" height="64" as="geometry"/></mxCell><mxCell id="panel" value="&lt;b&gt;Panel builder (code)&lt;/b&gt;&lt;br&gt;sampled by state, language, city tier and age band; protected traits are refused as dimensions" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E9D4E;fontColor=#202124;fontSize=12;fontFamily=Helvetica;strokeWidth=1.5;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="300" y="210" width="210" height="150" as="geometry"/></mxCell><mxCell id="q" value="&lt;b&gt;Quick Read&lt;/b&gt;&lt;br&gt;first reactions, understanding, confusion, concerns" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontColor=#202124;fontSize=12;fontFamily=Helvetica;strokeWidth=1.5;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="590" y="130" width="250" height="72" as="geometry"/></mxCell><mxCell id="st" value="&lt;b&gt;Audience Study&lt;/b&gt;&lt;br&gt;larger bounded panel, segment comparison" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontColor=#202124;fontSize=12;fontFamily=Helvetica;strokeWidth=1.5;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="860" y="130" width="250" height="72" as="geometry"/></mxCell><mxCell id="ask" value="&lt;b&gt;Ask the Panel&lt;/b&gt;&lt;br&gt;follow-ups; participant memory kept" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontColor=#202124;fontSize=12;fontFamily=Helvetica;strokeWidth=1.5;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="590" y="222" width="250" height="72" as="geometry"/></mxCell><mxCell id="fg" value="&lt;b&gt;Live Focus Group&lt;/b&gt;&lt;br&gt;moderated discussion you can interject into" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontColor=#202124;fontSize=12;fontFamily=Helvetica;strokeWidth=1.5;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="860" y="222" width="250" height="72" as="geometry"/></mxCell><mxCell id="bz" value="&lt;b&gt;Buzz Simulator&lt;/b&gt;&lt;br&gt;how talk may spread through a synthetic network" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontColor=#202124;fontSize=12;fontFamily=Helvetica;strokeWidth=1.5;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="590" y="314" width="250" height="72" as="geometry"/></mxCell><mxCell id="mc" value="&lt;b&gt;Message Check&lt;/b&gt;&lt;br&gt;does the intended message survive adaptation?" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontColor=#202124;fontSize=12;fontFamily=Helvetica;strokeWidth=1.5;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="860" y="314" width="250" height="72" as="geometry"/></mxCell><mxCell id="risk" value="&lt;b&gt;Risk Check (reasoning tier)&lt;/b&gt;&lt;br&gt;findings pinned to an image region or video moment, with cited ASCI clauses; severity computed by risk-rules-v1" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontColor=#202124;fontSize=12;fontFamily=Helvetica;strokeWidth=1.5;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="590" y="406" width="520" height="72" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;Analytics in code&lt;/b&gt;&lt;br&gt;distributions, segments, disagreement groups" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E9D4E;fontColor=#202124;fontSize=12;fontFamily=Helvetica;strokeWidth=1.5;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1170" y="130" width="200" height="76" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;Findings&lt;/b&gt;&lt;br&gt;reactions, confusion, concerns and open disagreements" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3C4043;fontColor=#202124;fontSize=12;fontFamily=Helvetica;strokeWidth=1.5;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1170" y="250" width="200" height="76" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;Hypotheses&lt;/b&gt;&lt;br&gt;questions to validate with real people" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3C4043;fontColor=#202124;fontSize=12;fontFamily=Helvetica;strokeWidth=1.5;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1170" y="370" width="200" height="76" as="geometry"/></mxCell><mxCell id="a4" value="&lt;b&gt;Launch Room and Proof Vault&lt;/b&gt;&lt;br&gt;readiness and report" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#9334E6;fontColor=#202124;fontSize=12;fontFamily=Helvetica;strokeWidth=1.5;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1170" y="490" width="200" height="76" as="geometry"/></mxCell><mxCell id="warn" value="&lt;b&gt;Synthetic, not real people&lt;/b&gt;&lt;br&gt;Every participant is labelled synthetic on screen and in exports. One model voices all of them, so agreement is not confirmation, and nothing here is calibrated against real outcomes." style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F