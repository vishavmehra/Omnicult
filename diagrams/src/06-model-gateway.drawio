<mxfile host="app.diagrams.net" agent="Omnicult diagrams" version="24.7.0"><diagram id="06-model-gateway" name="06-model-gateway"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_title" value="06 · Model gateway" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=22;fontColor=#202124;fontStyle=1;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1340" height="30" as="geometry"/></mxCell><mxCell id="t_sub" value="Every model call goes through one gateway: routing, budgets, validation, fallback and metering" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontColor=#5F6368;fontStyle=0;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="48" width="1340" height="22" as="geometry"/></mxCell><mxCell id="LG" value="Model gateway: backend/app/llm/gateway.py" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#5F6368;fillColor=#E8F0FE;strokeColor=#4285F4;dashed=0;opacity=60;textOpacity=100;" vertex="1" parent="1"><mxGeometry x="290" y="90" width="520" height="540" as="geometry"/></mxCell><mxCell id="LM" value="Vertex AI models (defaults)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#5F6368;fillColor=#E8F0FE;strokeColor=#4285F4;dashed=0;opacity=60;textOpacity=100;" vertex="1" parent="1"><mxGeometry x="860" y="90" width="300" height="540" as="geometry"/></mxCell><mxCell id="callers" value="&lt;b&gt;Callers&lt;/b&gt;&lt;br&gt;X-Ray, Transcreate, Tweak Chips, Quick Read, Risk Check, Voice Director, Remake, Comment Pulse, digest, embed