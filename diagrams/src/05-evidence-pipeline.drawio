<mxfile host="app.diagrams.net" agent="Omnicult diagrams" version="24.7.0"><diagram id="05-evidence-pipeline" name="05-evidence-pipeline"><mxGraphModel dx="1400" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="760" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_title" value="05 · Evidence pipeline" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=22;fontColor=#202124;fontStyle=1;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1340" height="30" as="geometry"/></mxCell><mxCell id="t_sub" value="Open sources become cited claims; code decides confidence, conflicts and the Evidence Meter" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontColor=#5F6368;fontStyle=0;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="48" width="1340" height="22" as="geometry"/></mxCell><mxCell id="LS" value="Open and public sources" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#5F6368;fillColor=#F8F9FA;strokeColor=#DADCE0;dashed=0;opacity=60;textOpacity=100;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="260" height="560" as="geometry"/></mxCell><mxCell id="src0" value="&lt;b&gt;Wikidata&lt;/b&gt;&lt;br&gt;entities, languages (CC0)" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F3F4;strokeColor=#80868B;fontColor=#202124;fontSize=12;fontFamily=Helvetica;strokeWidth=1.5;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="220" height="60" as="geometry"/></mxCell><mxCell id="src1" value="&lt;b&gt;Wikipedia pageviews&lt;/b&gt;&lt;br&gt;attention trends, not demand" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F3F4