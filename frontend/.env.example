# Copy to frontend/.env.local. Only NEXT_PUBLIC_* values reach the browser. Never put secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# dev | firebase  (dev sends the backend's development token and needs no sign-in; local only)
NEXT_PUBLIC_AUTH_MODE=dev
# Firebase web app config (Firebase console > Project settings > Your apps). Public identifiers, not secrets.
# Enable the Google, Email/Password and Anonymous providers for sign-in and "Try the demo".
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# 1 = serve contracts/fixtures through the development mock transport (ignored in production builds)
NEXT_PUBLIC_API_MOCK=0
