# Only pyproject.toml, uv.lock, alembic.ini, migrations/ and app/ go into the image (see Dockerfile).
.venv/
.pytest_cache/
.ruff_cache/
__pycache__/
*.py[cod]
.env
.env.*
!.env.example
*.db
*.db-shm
*.db-wal
/storage/
/tests/
# scripts/ stays out of the image except the idempotent seed scripts (run as a Cloud Run job).
/scripts/*
!/scripts/seed_*.py
Dockerfile
.dockerignore
.gcloudignore
