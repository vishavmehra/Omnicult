# Copy to backend/.env and fill in. Never commit real values.
# Every variable here is server-side only.

# --- Application ---
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated CORS allow-list
FRONTEND_ORIGINS=http://localhost:3000

# --- Authentication ---
# firebase | dev  (dev is refused when APP_ENV=production)
AUTH_MODE=dev
# Firebase project id: the expected `aud` of ID tokens (iss = https://securetoken.google.com/<id>). Public, not a secret.
FIREBASE_PROJECT_ID=
# Only for ASSET_STORAGE_BACKEND=supabase (replaced by Cloud Storage); not used for authentication.
SUPABASE_URL=

# --- Database ---
# Local: sqlite+aiosqlite:///./nativeproof.db   Supabase: postgresql+asyncpg://...
DATABASE_URL=sqlite+aiosqlite:///./nativeproof.db

# --- Model gateway (Google only; docs/GOOGLE_ACCESS_AUDIT.md) ---
# vertex: Vertex AI, billed to GOOGLE_CLOUD_PROJECT, authenticated with Application Default Credentials
#         (`gcloud auth application-default login` locally, the service account on Cloud Run).
# gemini_api: the Gemini Developer API with GEMINI_API_KEY. Its free tier may use prompts to improve Google products,
#             so never use it with real brand data; development and fallback only.
GOOGLE_GENAI_BACKEND=vertex
GOOGLE_CLOUD_PROJECT=
# Text models are available at `global`; image generation always uses `global` regardless of this value.
GOOGLE_CLOUD_LOCATION=global
GEMINI_API_KEY=
# Model ids are configuration. Blank = the default below (verified with scripts/verify_google_models.py on 2026-11-17).
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_DEFAULT=gemini-3.8-flash
GEMINI_MODEL_REASONING=gemini-4-argon
GEMINI_MODEL_IMAGE=gemini-3.1-flash-image
GEMINI_MODEL_TTS=gemini-3.8-flash-tts
GEMINI_MODEL_LIVE=gemini-live-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Changing the embedding model or dimensions starts a new vector space: stored text is re-embedded.
GEMINI_EMBEDDING_DIMENSIONS=768
# Estimated-cost ceilings in USD (price table: app/llm/registry.py). A call that would cross either is refused first.
AI_RUN_BUDGET_USD=0.50
AI_DAILY_BUDGET_USD=5.0
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- Qloo (official hackathon harness, @qloo/qloo-harness >= 0.1.26) ---
# Event credential; setting it enables live mode (verify with `uv run python -m scripts.qloo_live_smoke`)
QLOO_API_KEY=
# Leave blank for the official host (https://api.qloo.com). Set https://hackathon.api.qloo.com only if the
# event key belongs to that host (the smoke script's --base-url tells you).
QLOO_BASE_URL=
# Blank = auto: the official harness when Node and the pinned harness exist, else direct REST. Or: harness | rest
QLOO_TRANSPORT=
# Path to the qloo CLI
QLOO_BIN=qloo
QLOO_TIMEOUT_SECONDS=30

# --- Uploaded assets ---
# database (default; bytes in a table, for local development and tests) or supabase (private Storage bucket
# `assets`, created by migration 0006). supabase needs SUPABASE_URL and SUPABASE_SECRET_KEY; startup fails without them.
ASSET_STORAGE_BACKEND=database
# Server-side Supabase secret key (sb_secret_...): Storage access only. Never put it in the frontend.
SUPABASE_SECRET_KEY=
MAX_IMAGE_BYTES=5242880

# --- Limits ---
MAX_ACTIVE_RUNS_PER_USER=2
# Largest live population study accepted; larger requests get a 422 that names the limit.
POPULATION_MAX_PARTICIPANTS=600

# --- Audience Lab (Quick Read, Audience Study, Ask the Panel, Risk Check) ---
# Work limits: a larger request gets a 422 that names the limit, never a silent reduction.
AUDIENCE_QUICK_READ_MAX_PARTICIPANTS=24
AUDIENCE_STUDY_MAX_PARTICIPANTS=60
AUDIENCE_ASK_MAX_PARTICIPANTS=60
AUDIENCE_RUN_TIMEOUT_SECONDS=900
# --- Media: video and audio uploads, ffmpeg, Creative X-Ray ---
# Largest video or audio upload and longest clip (images keep MAX_IMAGE_BYTES).
MAX_MEDIA_BYTES=52428800
MAX_MEDIA_SECONDS=60
# ffmpeg and ffprobe: names on PATH or absolute paths. Detected at startup; without them video and audio fail with a
# clear PROVIDER_NOT_CONFIGURED error and images keep working. The Cloud Run image has both.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_PROBE_TIMEOUT_SECONDS=20
MEDIA_TOOL_TIMEOUT_SECONDS=90
# Keyframes: scene changes at least KEYFRAME_MIN_GAP_MS apart, a frame at least every KEYFRAME_MAX_GAP_MS, at most
# KEYFRAME_MAX_COUNT per video (each frame is one vision call).
KEYFRAME_SCENE_THRESHOLD=0.3
KEYFRAME_MIN_GAP_MS=1000
KEYFRAME_MAX_GAP_MS=4000
KEYFRAME_MAX_COUNT=16
KEYFRAME_MAX_WIDTH=768
# Lifetime of a Cloud Storage signed URL for keyframes and thumbnails (ASSET_STORAGE_BACKEND=gcs).
MEDIA_SIGNED_URL_SECONDS=600
# --- Proof Vault ---
# How long a report export download link works (seconds, 30 to 3600).
PROOF_EXPORT_URL_TTL_SECONDS=300
