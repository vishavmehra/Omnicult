      "transcript": [
        {
          "id": "mh-vo-1",
          "start_ms": 500,
          "end_ms": 4261,
          "scene_id": "mh-s1",
          "text": "दिवाळी आली की घरभर फराळाचा सुगंध दरवळतो.",
          "language": "mr",
          "script": "Deva",
          "translation_en": "When Diwali arrives, the aroma of faral fills the whole house.",
          "burned_caption": true
        },
        {
          "id": "mh-vo-2",
          "start_ms": 5061,
          "end_ms": 9741,
          "scene_id": "mh-s2",
          "text": "आजीच्या हातची चकली, करंजी, बेसनाचे लाडू…",
          "language": "mr",
          "script": "Deva",
          "translation_en": "Grandma's own chakli, karanji, besan laddoos…",
          "burned_caption": true
        },
        {
          "id": "mh-vo-3",
          "start_ms": 10541,
          "end_ms": 14582,
          "scene_id": "mh-s3",
          "text": "तीच घरची चव, आता आमोद फेस्टिव्ह टिनमध्ये.",
          "language": "mr",
          "script": "Deva",
          "translation_en": "That same taste of home, now in the Aamod Festive Tin.",
          "burned_caption": true
        },
        {
          "id": "mh-vo-4",
          "start_ms": 15382,
          "end_ms": 19462,
          "scene_id": "mh-s4",
          "text": "या भाऊबीजेला, आपल्या माणसांना द्या गोड भेट.",
          "language": "mr",
          "script": "Deva",
          "translation_en": "This Bhau Beej, give your loved ones a sweet gift.",
          "burned_caption": true
        },
        {
          "id": "mh-vo-5",
          "start_ms": 20462,
          "end_ms": 23943,
          "scene_id": "mh-s5",
          "text": "भाऊबीजेपूर्वी घरपोच. आजच ऑर्डर करा!",
          "language": "mr",
          "script": "Deva",
          "translation_en": "Delivered home before Bhau Beej. Order today!",
          "burned_caption": false
        },
        {
          "id": "mh-vo-6",
          "start_ms": 24393,
          "end_ms": 28114,
          "scene_id": "mh-s5",
          "text": "आमोद. Every bond, a little sweeter.",
          "language": "mr",
          "script": "Deva",
          "translation_en": "Aamod. Every bond, a little sweeter.",
          "burned_caption": false
        }
