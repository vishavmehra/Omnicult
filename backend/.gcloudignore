# What `gcloud builds submit backend` uploads. Keep in step with .dockerignore (the image only needs the files named
# in the Dockerfile); .env files are never uploaded.
# Directory patterns are anchored with a leading slash: unanchored, gitignore rules could also drop a package under app/.
.git/
.venv/
.pytest_cache/
.ruff_cache/
__pycache__/
*.py[cod]
.env
.env.*
!.env.example
*.db
*.db-shm
*.db-wal
/storage/
/tests/
# scripts/ stays out of the image except the idempotent seed scripts (run as a Cloud Run job).
/scripts/*
!/scripts/seed_*.py
